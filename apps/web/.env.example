# Required env vars.
# Local development: copy to .env.local. Keep secrets in 1Password and write only
# op://<vault>/<item>/<field> references here; run what needs them via
#   op run --env-file=apps/web/.env.local -- <command>
# Production (Cloudflare Workers): set non-secret values in wrangler.jsonc `vars`,
# and secrets via `wrangler secret put` or the Cloudflare dashboard.

# === Elasticsearch (toyo-es.ldas.jp, CF Access Service Token 保護) ===
ES_URL=https://toyo-es.ldas.jp
CF_ACCESS_CLIENT_ID=op://<vault>/<item>/client_id
CF_ACCESS_CLIENT_SECRET=op://<vault>/<item>/client_secret

# === Index settings ===
ALLOWED_INDICES=morrison_bib
NEXT_PUBLIC_INDEX_NAME=morrison_bib
FULLTEXT_INDEX_NAME=morrison

# === Omeka S (scripts/fetch-omeka.ts 用。サイト本体は使わない) ===
OMEKA_BASE_URL=
OMEKA_USER=op://<vault>/<item>/username
OMEKA_PASSWORD=op://<vault>/<item>/password

# === DTS Document: canonical TEI on S3 (SigV2 signed GET) ===
# 全て揃ったとき /api/dts/document が正本 TEI を S3 から返す。未設定なら ES 生成 TEI に
# フォールバック。本番は Worker secret (scripts/setup/register-s3-tei-secrets.zsh)。
# ローカルは op run 経由で注入推奨 (op://<vault>/<item>/s3_*)。
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 任意: xml/ を公開読み取りできるゲートウェイがあれば素の GET 先として使う (署名不要)
MORRISON_TEI_BASE=

# === Site ===
NEXT_PUBLIC_SITE_URL=https://morrison.toyobunko-lab.jp
NEXT_PUBLIC_GA_ID=
